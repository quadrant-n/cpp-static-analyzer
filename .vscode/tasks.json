    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install dependencies",
            "type": "shell",
            "command": "poetry",
            "args": [
                "install"
            ],
            "problemMatcher": []
        },
        {
            "label": "Install root",
            "type": "shell",
            "command": "poetry",
            "args": [
                "install",
                "--only-root"
            ],
            "problemMatcher": []
        },
        {
            "label": "Install developer dependencies",
            "type": "shell",
            "command": "poetry",
            "args": [
                "install",
                "--with",
                "dev"
            ],
            "problemMatcher": []
        },
        {
            "label": "Update lock",
            "type": "shell",
            "command": "poetry",
            "args": [
                "lock"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build package",
            "type": "shell",
            "command": "poetry",
            "args": [
                "build"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Use virtual environment",
            "type": "shell",
            "command": "poetry",
            "args": [
                "env",
                "use",
                ".venv/bin/python",
            ],
            "problemMatcher": []
        },
        {
            "label": "Use virtual environment",
            "type": "shell",
            "command": "poetry",
            "args": [
                "env",
                "use",
                ".venv/bin/python",
            ],
            "problemMatcher": []
        }
    ]
